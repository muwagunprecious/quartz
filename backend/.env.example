# Server Configuration
PORT=5003
NODE_ENV=development

# Database
# For Render: file:/var/data/database.db
# For Local: file:./prisma/dev.db
DATABASE_URL=file:./prisma/dev.db

# Security
JWT_SECRET=your_jwt_secret_here
ADMIN_PASSWORD=your_secure_admin_password_here

# Frontend URL for CORS
# For Render: https://your-frontend-domain.com
# For Local: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# File Uploads
# For Render: /var/data/uploads
# For Local: ./uploads
UPLOAD_PATH=./uploads

# AWS S3 (Optional - if using S3 instead of local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
